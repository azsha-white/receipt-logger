{
  "name": "receipt-logger",
  "private": true,
  "version": "0.0.1",
  "description": "Household receipt tracker: static front end on GitHub Pages, Google Apps Script API, Google Sheet as the record.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.ts\"",
    "gas:login": "clasp login",
    "gas:create": "node scripts/clasp-create.mjs",
    "gas:push": "clasp push --force",
    "gas:deploy": "node scripts/clasp-deploy.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
